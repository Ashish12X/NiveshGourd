PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/sangyan
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ── Adaptive AI Engine ──────────────────────────────────────────
# NEVER expose AI_API_KEY to the frontend.
# Supported providers: gemini | openai
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-2.0-flash
AI_REQUESTS_PER_15_MIN=20
DISABLE_AI_RATE_LIMIT=false

# ── Stage 5: Verification Engine ─────────────────────────────────────────────
# EVIDENCE_PROVIDER options: unavailable (default) | local_test | live
# Set to local_test for dev testing with deterministic fixtures.
# Set to live when a real search API is configured.
EVIDENCE_PROVIDER=local_test
# Per-user verification rate limit per 15 minutes
VERIFICATION_REQUESTS_PER_15_MIN=10
